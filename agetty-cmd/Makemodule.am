if BUILD_AGETTY
sbin_PROGRAMS += agetty
MANPAGES += agetty-cmd/agetty.8
dist_noinst_DATA += agetty-cmd/agetty.8.adoc

agetty_SOURCES = agetty-cmd/agetty.c \
		 agetty-cmd/agetty.h \
		 agetty-cmd/credentials.c \
		 agetty-cmd/issuefile.c \
		 agetty-cmd/issuefile-parser.c \
		 agetty-cmd/issuefile-parser.h \
		 agetty-cmd/tty.c \
		 agetty-cmd/utils.c

if USE_PLYMOUTH_SUPPORT
agetty_SOURCES += lib/plymouth-ctrl.c
endif

if LINUX
agetty_SOURCES += lib/netlink.c lib/netaddrq.c
endif

agetty_LDADD = $(LDADD) libcommon.la libcommon_logindefs.la

if BSD
agetty_LDADD += -lutil
endif

if HAVE_SYSTEMD
agetty_LDADD += $(SYSTEMD_LIBS)
agetty_CFLAGS = $(SYSTEMD_CFLAGS)
endif
check_PROGRAMS += test_agetty_issuefile
test_agetty_issuefile_SOURCES = agetty-cmd/issuefile-parser.c
test_agetty_issuefile_CFLAGS = $(AM_CFLAGS) -DTEST_PROGRAM
test_agetty_issuefile_LDADD = $(LDADD) libcommon.la

endif # BUILD_AGETTY
