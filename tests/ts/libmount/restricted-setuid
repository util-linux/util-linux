#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

TS_TOPDIR="${0%/*}/../.."
TS_DESC="unrestricted context after setuid(0)"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_skip_nonroot
ts_check_prog "runuser"
ts_check_prog "getent"
ts_check_test_command "$TS_CMD_MOUNT"
ts_check_test_command "$TS_CMD_UMOUNT"
ts_check_test_command "$TS_HELPER_LIBMOUNT_RESTRICTED"
getent passwd "$TS_TESTUSER" &> /dev/null || \
	ts_skip "$TS_TESTUSER user is missing"

# A static copy outside the build tree also works with private home directories.
WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/libmount-restricted.XXXXXX") || \
	ts_die "cannot create test directory"
cleanup() {
	"$TS_CMD_UMOUNT" "$WORKDIR" &> /dev/null || :
	rm -rf "$WORKDIR"
}
trap cleanup EXIT
# /tmp may be nosuid. A private tmpfs gives the helper usable setuid semantics.
"$TS_CMD_MOUNT" -n -t tmpfs -o mode=0755 tmpfs "$WORKDIR" || \
	ts_skip "cannot mount a setuid test filesystem"
TESTPROG="$WORKDIR/test_mount_restricted"
cp "$TS_HELPER_LIBMOUNT_RESTRICTED" "$TESTPROG" || ts_die "cannot copy test helper"
ts_init_suid "$TESTPROG"
[ -u "$TESTPROG" ] || ts_skip "cannot setup setuid test helper"

runuser -u "$TS_TESTUSER" -- "$TESTPROG" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
rc=$?
[ "$rc" -eq 77 ] && ts_skip "setuid execution is unavailable"
[ "$rc" -eq 0 ] || ts_die "context check failed"

ts_finalize
