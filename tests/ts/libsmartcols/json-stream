TS_TOPDIR="${0%/*}/../.."
TS_DESC="json stream"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

TESTPROG="$TS_HELPER_LIBSMARTCOLS_CONTINUOUS_JSON"
ts_check_test_command "$TESTPROG"

# scols_table_print_range() prints the lines without the enclosing root object
# and array, so the output has to be a sequence of top-level JSON values; the
# objects are never comma separated, no matter if they are printed by one call
# (--batch) or by more calls.
for fmt in pretty compact lines; do
	ts_init_subtest "batch-$fmt"
	LIBSMARTCOLS_JSON="$fmt" ts_run "$TESTPROG" --batch 3 >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
	ts_finalize_subtest

	ts_init_subtest "stream-$fmt"
	LIBSMARTCOLS_JSON="$fmt" ts_run "$TESTPROG" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
	ts_finalize_subtest
done

ts_finalize
