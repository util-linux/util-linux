TS_TOPDIR="${0%/*}/../.."
TS_DESC="free space"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_SFDISK"

# The layout below places the second logical partition at sector 81920, so its
# EBR is at sector 79872. The free space in front of it has to end at 79871,
# otherwise the EBR (and the first sector of the partition) would be reported
# as unused -- and for example 'sfdisk --discard-free' would destroy the chain
# of the logical partitions.
LAYOUT="label: dos
unit: sectors
2048,20480,L
22528,79872,E
24576,20480,L
81920,20480,L"

ts_init_subtest "dos-logical-gap"
TEST_IMAGE_NAME=$(ts_image_init 50)
echo "$LAYOUT" | $TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
$TS_CMD_SFDISK --list-free "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

# The EBR of the *first* logical partition is stored at the very beginning of
# the container, so it's in front of the free space rather than behind it. The
# gap in front of the first logical partition must not be lost.
ts_init_subtest "dos-first-logical-gap"
TEST_IMAGE_NAME=$(ts_image_init 50)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" &> /dev/null <<EOF
label: dos
unit: sectors
2048,20480,L
22528,79872,E
61440,20480,L
EOF
$TS_CMD_SFDISK --list-free "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

# cxt->first_lba does not have to match the distance between the EBR and the
# logical partition as it is stored in the partition table. The layout below is
# written with first-lba 4096, but read back with the default 2048, so the EBR
# of the last logical partition is located exactly at the beginning of the gap.
ts_init_subtest "dos-logical-gap-first-lba"
TEST_IMAGE_NAME=$(ts_image_init 60)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" &> /dev/null <<EOF
label: dos
first-lba: 4096
unit: sectors
4096,20480,L
24576,79872,E
28672,22529,L
57344,20480,L
EOF
$TS_CMD_SFDISK --list-free "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

# Enlarging a logical partition must stop before the EBR of the next one.
ts_init_subtest "dos-resize-logical"
TEST_IMAGE_NAME=$(ts_image_init 50)
echo "$LAYOUT" | $TS_CMD_SFDISK "$TEST_IMAGE_NAME" &> /dev/null
echo ',+' | $TS_CMD_SFDISK --no-reread -N5 "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

ts_finalize
