TS_TOPDIR="${0%/*}/../.."
TS_DESC="discard-free"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_SFDISK"

ts_init_subtest "ebr"
TEST_IMAGE_NAME=$(ts_image_init 50)

$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
unit: sectors
2048,20480,L
22528,79872,E
24576,20480,L
49152,20480,L
EOF

$TS_CMD_SFDISK --no-act --discard-free "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"

ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

ts_finalize
