TS_TOPDIR="${0%/*}/../.."
TS_DESC="first-lba header"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_SFDISK"

# The second partition has to follow the first one rather than use the
# free space before it (see #3097).
ts_init_subtest "dos"
TEST_IMAGE_NAME=$(ts_image_init 10)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
first-lba: 2MiB
start=4096, size=2MiB, type=L
type=L
EOF
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

# Logical partitions start first-lba sectors after their EBR.
ts_init_subtest "dos-logical"
TEST_IMAGE_NAME=$(ts_image_init 10)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
first-lba: 4096
start=4096, size=2MiB, type=L
type=E
size=1MiB, type=L
size=1MiB, type=L
EOF
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

ts_init_subtest "dos-range"
TEST_IMAGE_NAME=$(ts_image_init 10)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
first-lba: 0
type=L
EOF
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
first-lba: 20480
type=L
EOF
# The errno text depends on the libc (and sfdisk prints it with %m).
sed -i 's/\(disk label not created\): .*/\1/' "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

ts_init_subtest "dos-invalid"
TEST_IMAGE_NAME=$(ts_image_init 10)
$TS_CMD_SFDISK "$TEST_IMAGE_NAME" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG" <<EOF
label: dos
first-lba: foo
type=L
EOF
# The errno text depends on the libc (and sfdisk prints it with %m).
sed -i 's/\(disk label not created\): .*/\1/' "$TS_ERRLOG"
ts_fdisk_clean "$TEST_IMAGE_NAME"
ts_finalize_subtest

ts_finalize
