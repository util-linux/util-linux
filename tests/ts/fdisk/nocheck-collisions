TS_TOPDIR="${0%/*}/../.."
TS_DESC="nocheck-collisions"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_FDISK"
ts_check_prog "mkfs.ext2"

TEST_IMAGE_NAME=$(ts_image_init 10)

mkfs.ext2 -q -F "$TEST_IMAGE_NAME" &> /dev/null

function test_collision
{
	local out

	out=$(echo q | $TS_CMD_FDISK "$@" "$TEST_IMAGE_NAME" 2>&1)
	if echo "$out" | grep -q "contains 'ext2' signature"; then
		echo "ext2 signature warning: yes"
	else
		echo "ext2 signature warning: no"
	fi
}

ts_log "default (collision check enabled)"
test_collision >> "$TS_OUTPUT"

ts_log "collision check disabled"
test_collision --nocheck-collisions >> "$TS_OUTPUT"

ts_finalize
