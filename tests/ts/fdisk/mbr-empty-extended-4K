TS_TOPDIR="${0%/*}/../.."
TS_DESC="MBR - empty extended, 4K sectors"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_FDISK"
ts_check_test_command "$TS_HELPER_MD5"

FDISK_CMD_INIT="o\nx\ni\n0x1\nr\n"
FDISK_CMD_CREATE_EXTENDED="n\ne\n1\n\n\n"
FDISK_CMD_WRITE_CLOSE="w\nq\n"

TEST_IMAGE_NAME=$(ts_image_init 10)

echo -e "${FDISK_CMD_INIT}${FDISK_CMD_CREATE_EXTENDED}${FDISK_CMD_WRITE_CLOSE}" \
	| $TS_CMD_FDISK --noauto-pt --sector-size 4096 ${TEST_IMAGE_NAME} &> /dev/null
ts_image_md5sum >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"

$TS_CMD_FDISK --sector-size 4096 --list-details ${TEST_IMAGE_NAME} >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
ts_fdisk_clean ${TEST_IMAGE_NAME}

ts_finalize
