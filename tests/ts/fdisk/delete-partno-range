TS_TOPDIR="${0%/*}/../.."
TS_DESC="delete partition number out of range"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_FDISK"
ts_check_test_command "$TS_CMD_SFDISK"

function delete_partno {
	$TS_CMD_SFDISK --delete ${TEST_IMAGE_NAME} $1 >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"
	echo "rc=$?" >> "$TS_OUTPUT"
	ts_fdisk_clean ${TEST_IMAGE_NAME}
}

ts_init_subtest "sun"
TEST_IMAGE_NAME=$(ts_image_init 10)
echo -e "s\nw\n" | $TS_CMD_FDISK --noauto-pt ${TEST_IMAGE_NAME} &> /dev/null
delete_partno 9
ts_finalize_subtest

ts_init_subtest "sgi"
TEST_IMAGE_NAME=$(ts_image_init 10)
echo -e "G\nw\n" | $TS_CMD_FDISK --noauto-pt ${TEST_IMAGE_NAME} &> /dev/null
delete_partno 17
ts_finalize_subtest

ts_finalize
