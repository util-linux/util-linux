#
# A GPT whose backup header is valid, but describes a partition entries array
# with a different number of entries than the primary header.
#
# libfdisk keeps only the primary entries array in memory and uses it with
# both headers, so such a backup header has to be handled as corrupt and
# rebuilt from the primary header.
#

TS_TOPDIR="${0%/*}/../.."
TS_DESC="gpt-backup-geometry"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_SFDISK"
ts_check_prog "python3"

ts_init_subtest "backup-nentries-mismatch"

TEST_IMAGE_NAME=$(ts_image_init 10)

echo -e "label: gpt\n,1M\n" | $TS_CMD_SFDISK --no-reread ${TEST_IMAGE_NAME} &> /dev/null

# Rewrite the backup entries array and header to describe twice as many
# entries as the primary header, with valid CRCs.
python3 - "$TEST_IMAGE_NAME" <<'PYEOF' >&2
import struct, zlib, os, sys
SEC = 512
def crc32(b): return zlib.crc32(b) & 0xffffffff
path = sys.argv[1]
total = os.path.getsize(path) // SEC
with open(path, 'r+b') as f:
    f.seek(SEC)
    ph = bytearray(f.read(SEC))
    n = struct.unpack_from('<I', ph, 80)[0]
    esz = struct.unpack_from('<I', ph, 84)[0]
    f.seek(struct.unpack_from('<Q', ph, 72)[0] * SEC)
    ents = f.read(n * esz) + b'\x00' * (n * esz)
    esects = len(ents) // SEC
    elba = total - 1 - esects
    f.seek(elba * SEC)
    f.write(ents)
    f.seek((total - 1) * SEC)
    bh = bytearray(f.read(SEC))
    # the larger array has to end before the first usable LBA to be accepted
    struct.pack_into('<Q', bh, 40, esects + 2)     # first_usable_lba
    struct.pack_into('<Q', bh, 72, elba)           # partition_entry_lba
    struct.pack_into('<I', bh, 80, 2 * n)          # npartition_entries
    struct.pack_into('<I', bh, 88, crc32(ents))    # partition_entry_array_crc32
    struct.pack_into('<I', bh, 16, 0)              # header_crc32 (zero for CRC)
    struct.pack_into('<I', bh, 16, crc32(bytes(bh[:struct.unpack_from('<I', bh, 12)[0]])))
    f.seek((total - 1) * SEC)
    f.write(bh)
PYEOF

# Modify the table; the backup header has to be rebuilt from the primary one.
$TS_CMD_SFDISK --no-reread --part-label ${TEST_IMAGE_NAME} 1 test >> $TS_OUTPUT 2>&1
$TS_CMD_SFDISK --verify ${TEST_IMAGE_NAME} >> $TS_OUTPUT 2>> $TS_ERRLOG

python3 - "$TEST_IMAGE_NAME" <<'PYEOF' >> $TS_OUTPUT
import struct, os, sys
SEC = 512
path = sys.argv[1]
total = os.path.getsize(path) // SEC
with open(path, 'rb') as f:
    for name, lba in (('primary', 1), ('backup', total - 1)):
        f.seek(lba * SEC)
        h = f.read(SEC)
        print('%s: entries=%d entry-size=%d' % (name,
              struct.unpack_from('<I', h, 80)[0], struct.unpack_from('<I', h, 84)[0]))
PYEOF

ts_fdisk_clean $TEST_IMAGE_NAME

ts_finalize_subtest
ts_finalize
