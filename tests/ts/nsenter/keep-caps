TS_TOPDIR="${0%/*}/../.."
TS_DESC="preserve capabilities when entering user namespaces"

. "$TS_TOPDIR/functions.sh"
ts_init "$*"

ts_check_test_command "$TS_CMD_NSENTER"
ts_check_test_command "$TS_CMD_UNSHARE"

if [ "$(id -u)" -eq 0 ]; then
	ts_check_test_command "$TS_CMD_SETPRIV"
	test_uid=$(id -u "$TS_TESTUSER" 2>/dev/null) || ts_skip "test user not found"
	test_gid=$(id -g "$TS_TESTUSER" 2>/dev/null) || ts_skip "test group not found"

	run_as_test_user() {
		"$TS_CMD_SETPRIV" --reuid="$test_uid" --regid="$test_gid" --clear-groups "$@"
	}
else
	run_as_test_user() {
		"$@"
	}
fi

ts_cd "$TS_OUTDIR"

PIDFILE="$TS_OUTDIR/${TS_TESTNAME}.pid"
CAPS_WITH_UTS="$TS_OUTDIR/${TS_TESTNAME}-with-uts"
CAPS_USER_ONLY="$TS_OUTDIR/${TS_TESTNAME}-user-only"
CAPS_USER_PARENT="$TS_OUTDIR/${TS_TESTNAME}-user-parent"
rm -f "$PIDFILE" "$CAPS_WITH_UTS" "$CAPS_USER_ONLY" "$CAPS_USER_PARENT"
# Use a nested user namespace so --user-parent enters a namespace distinct
# from the test process's current user namespace.
run_as_test_user "$TS_CMD_UNSHARE" --user --map-current-user --uts -- \
	"$TS_CMD_UNSHARE" --user --map-current-user --uts -- \
	/bin/sh -c 'echo $$; exec sleep 30' > "$PIDFILE" 2>/dev/null &
TARGET_SHELL=$!
trap 'kill "$TARGET_SHELL" "$TARGET" &>/dev/null' EXIT

for _ in $(seq 1 50); do
	read -r TARGET < "$PIDFILE" 2>/dev/null && [ -n "$TARGET" ] && break
	sleep 0.1
done

if [ -z "${TARGET:-}" ] || [ ! -d "/proc/$TARGET" ]; then
	ts_skip "cannot set up a user namespace"
fi

run_as_test_user "$TS_CMD_NSENTER" --target "$TARGET" --user --uts \
	--preserve-credentials --keep-caps \
	grep '^CapEff:' /proc/self/status >"$CAPS_WITH_UTS" 2>>"$TS_ERRLOG" || \
	ts_skip "cannot enter the user namespace"
if grep -q '^CapEff:[[:space:]]*0000000000000000$' "$CAPS_WITH_UTS"; then
	ts_skip "user namespace does not grant capabilities"
fi

run_as_test_user "$TS_CMD_NSENTER" --target "$TARGET" --user \
	--preserve-credentials --keep-caps \
	grep '^CapEff:' /proc/self/status >"$CAPS_USER_ONLY" 2>>"$TS_ERRLOG" || \
	ts_skip "cannot enter the user namespace"

if cmp -s "$CAPS_WITH_UTS" "$CAPS_USER_ONLY"; then
	echo "preserved" >>"$TS_OUTPUT"
else
	echo "not preserved" >>"$TS_OUTPUT"
fi

run_as_test_user "$TS_CMD_NSENTER" --target "$TARGET" --user-parent \
	--preserve-credentials --keep-caps \
	grep '^CapEff:' /proc/self/status >"$CAPS_USER_PARENT" 2>>"$TS_ERRLOG" || \
	ts_skip "cannot enter the parent user namespace"

if cmp -s "$CAPS_WITH_UTS" "$CAPS_USER_PARENT"; then
	echo "preserved" >>"$TS_OUTPUT"
else
	echo "not preserved" >>"$TS_OUTPUT"
fi

kill "$TARGET" &>/dev/null
wait "$TARGET_SHELL" &>/dev/null || true
rm -f "$PIDFILE" "$CAPS_WITH_UTS" "$CAPS_USER_ONLY" "$CAPS_USER_PARENT"

ts_finalize
