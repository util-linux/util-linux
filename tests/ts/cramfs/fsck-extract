TS_TOPDIR="${0%/*}/../.."
TS_DESC="fsck extract"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_MKCRAMFS"
ts_check_test_command "$TS_CMD_FSCKCRAMFS"
ts_check_prog "dd"
ts_check_prog "od"

IMAGE_SOURCE="$TS_OUTDIR/${TS_TESTNAME}-data"
IMAGE_FILE="$TS_OUTDIR/${TS_TESTNAME}-cramfs.img"
EXTRACT_DIR="$TS_OUTDIR/${TS_TESTNAME}-extract"
OUTSIDE_FILE="$TS_OUTDIR/${TS_TESTNAME}-outside"
NESTED_SOURCE="$TS_OUTDIR/${TS_TESTNAME}-nested-data"
NESTED_IMAGE="$TS_OUTDIR/${TS_TESTNAME}-nested-cramfs.img"
NESTED_EXTRACT="$TS_OUTDIR/${TS_TESTNAME}-nested-extract"
DEEP_SOURCE="$TS_OUTDIR/${TS_TESTNAME}-deep-data"
DEEP_IMAGE="$TS_OUTDIR/${TS_TESTNAME}-deep-cramfs.img"
DEEP_EXTRACT="$TS_OUTDIR/${TS_TESTNAME}-deep-extract"

# create an image with entries 'aaaa' (symlink to $OUTSIDE_FILE) and 'bbbb'
# (regular file), then rename 'bbbb' to $1 in the image
function make_image() {
	local off flags

	rm -rf "$IMAGE_SOURCE" "$EXTRACT_DIR" "$IMAGE_FILE"
	mkdir -p "$IMAGE_SOURCE"
	ln -s "$OUTSIDE_FILE" "$IMAGE_SOURCE/aaaa"
	echo "replaced" > "$IMAGE_SOURCE/bbbb"

	$TS_CMD_MKCRAMFS -N little -b 4096 "$IMAGE_SOURCE" "$IMAGE_FILE" &> /dev/null
	[ -s "$IMAGE_FILE" ] || ts_die "Cannot create $IMAGE_FILE"

	off=$(grep -obUa "bbbb" "$IMAGE_FILE" | head -n1 | cut -d: -f1)
	[ -n "$off" ] || ts_die "entry name not found in $IMAGE_FILE"
	printf "%b" "$1" | dd of="$IMAGE_FILE" bs=1 seek="$off" count=4 conv=notrunc &> /dev/null

	# drop the fsid flag, so the patched image is accepted without a new CRC
	flags=$(od -An -tu1 -j8 -N1 "$IMAGE_FILE" | tr -d ' ')
	printf "\\x$(printf %02x $(( flags & ~1 )))" |
		dd of="$IMAGE_FILE" bs=1 seek=8 count=1 conv=notrunc &> /dev/null
}

echo "original" > "$OUTSIDE_FILE"

ts_log "duplicate name"
make_image "aaaa"
$TS_CMD_FSCKCRAMFS --extract="$EXTRACT_DIR" "$IMAGE_FILE" &> /dev/null
ts_log "ret: $?"
ts_log "outside: $(cat "$OUTSIDE_FILE")"

ts_log "dot-dot name"
make_image "..\\0\\0"
$TS_CMD_FSCKCRAMFS --extract="$EXTRACT_DIR" "$IMAGE_FILE" 2>&1 >/dev/null |
	sed -n 's/.*: dangerous filename/dangerous filename/p' >> $TS_OUTPUT
ts_log "ret: ${PIPESTATUS[0]}"

ts_log "nested directory extraction"
rm -rf "$NESTED_SOURCE" "$NESTED_EXTRACT" "$NESTED_IMAGE"
mkdir -p "$NESTED_SOURCE/one/two"
printf "nested\n" > "$NESTED_SOURCE/one/two/file"
$TS_CMD_MKCRAMFS -N little -b 4096 "$NESTED_SOURCE" "$NESTED_IMAGE" &> /dev/null
[ -s "$NESTED_IMAGE" ] || ts_die "Cannot create $NESTED_IMAGE"
$TS_CMD_FSCKCRAMFS --extract="$NESTED_EXTRACT" "$NESTED_IMAGE" &> /dev/null
if ! diff -r "$NESTED_SOURCE" "$NESTED_EXTRACT" &> /dev/null; then
	ts_die "Nested extraction differs from source"
fi
ts_log "nested extraction: ok"

# An excessively deep directory tree must fail cleanly instead of exhausting
# the process stack during recursive extraction.
ts_log "deep directory tree"
rm -rf "$DEEP_SOURCE" "$DEEP_EXTRACT" "$DEEP_IMAGE"
mkdir -p "$DEEP_SOURCE"
path="$DEEP_SOURCE"
depth=0
while [ "$depth" -le 256 ]; do
	path="$path/d"
	mkdir "$path" || ts_die "Cannot create deep test directory"
	depth=$((depth + 1))
done
printf "deep\n" > "$path/file"
$TS_CMD_MKCRAMFS -N little -b 4096 "$DEEP_SOURCE" "$DEEP_IMAGE" &> /dev/null
[ -s "$DEEP_IMAGE" ] || ts_die "Cannot create $DEEP_IMAGE"
$TS_CMD_FSCKCRAMFS --extract="$DEEP_EXTRACT" "$DEEP_IMAGE" 2>&1 >/dev/null |
	sed -n 's/.*directory depth exceeds.*/directory depth limit/p' >> "$TS_OUTPUT"
ts_log "ret: ${PIPESTATUS[0]}"

rm -rf "$DEEP_EXTRACT"
ts_log "low descriptor limit"
(ulimit -n 32; $TS_CMD_FSCKCRAMFS --extract="$DEEP_EXTRACT" "$DEEP_IMAGE") \
	2>&1 >/dev/null |
	sed -n 's/.*directory depth exceeds.*/directory depth limit/p' >> "$TS_OUTPUT"
ts_log "ret: ${PIPESTATUS[0]}"

rm -rf "$IMAGE_SOURCE" "$EXTRACT_DIR" "$IMAGE_FILE" "$OUTSIDE_FILE"
rm -rf "$DEEP_SOURCE" "$DEEP_EXTRACT" "$DEEP_IMAGE"
rm -rf "$NESTED_SOURCE" "$NESTED_EXTRACT" "$NESTED_IMAGE"

ts_finalize
