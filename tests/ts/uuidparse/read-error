TS_TOPDIR="${0%/*}/../.."
TS_DESC="uuidparse stdin read error"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_UUIDPARSE"
ts_check_prog "python3"

python3 - "$TS_CMD_UUIDPARSE" > "$TS_OUTPUT" 2> "$TS_ERRLOG" <<'PY'
import os
import subprocess
import sys

fd = os.open(".", os.O_RDONLY | os.O_DIRECTORY)
try:
    os.read(fd, 1)
except OSError:
    pass
else:
    os.close(fd)
    sys.exit(77)

try:
    proc = subprocess.run([sys.argv[1]], stdin=fd, capture_output=True, timeout=1)
except subprocess.TimeoutExpired:
    print("uuidparse timed out")
    sys.exit(1)
finally:
    os.close(fd)

if proc.returncode == 0 or b"read failed" not in proc.stderr:
    print("uuidparse did not report a read error")
    sys.exit(1)

print("stdin read error reported")
PY
rc=$?
if [ "$rc" -eq 77 ]; then
	ts_skip "reading a directory does not fail"
fi
echo "return value: $rc" >> "$TS_OUTPUT"

ts_finalize
