TS_TOPDIR="${0%/*}/../.."
TS_DESC="poll json"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_FINDMNT"
ts_check_test_command "$TS_CMD_MOUNT"
ts_check_test_command "$TS_CMD_UNSHARE"

ts_skip_nonroot
ts_skip_docker

export MNT="$TS_OUTDIR/$TS_TESTNAME-$$-mnt"
export POLL="$TS_OUTDIR/$TS_TESTNAME.poll"
export TS_CMD_FINDMNT TS_CMD_MOUNT TS_ERRLOG

mkdir -p "$MNT/a" "$MNT/b" "$MNT/c"

# Everything in a private mount namespace, so that the poll mode reports our
# own mount points only; the namespace (and the mounts) are gone when the
# subshell exits.
$TS_CMD_UNSHARE --mount --propagation private -- bash -c '
	$TS_CMD_FINDMNT --poll --json --timeout 30000 -o ACTION,TARGET \
		>"$POLL" 2>> "$TS_ERRLOG" &
	FINDMNT_PID=$!
	sleep 1

	# Mount three file systems at the same time. They are likely to be
	# reported by the same poll() wakeup, which used to print the JSON
	# objects separated by commas (without an enclosing array).
	MOUNT_PIDS=()
	for d in a b c; do
		$TS_CMD_MOUNT -t tmpfs tmpfs "$MNT/$d" &
		MOUNT_PIDS+=($!)
	done
	wait "${MOUNT_PIDS[@]}"

	# wait for all the events, max. 10 seconds
	for i in $(seq 100); do
		[ "$(grep -c . "$POLL")" -ge 3 ] && break
		sleep 0.1
	done

	kill $FINDMNT_PID
	wait $FINDMNT_PID 2> /dev/null
'

rmdir "$MNT/a" "$MNT/b" "$MNT/c" "$MNT"

# every event has to be a stand-alone JSON object on its own line; a line that
# starts with a comma is the separator printed between events of one wakeup
echo "mounts: $(grep -c '"action":"mount"' "$POLL")" >> "$TS_OUTPUT"
echo "comma separated: $(grep -c '^,' "$POLL")" >> "$TS_OUTPUT"
echo "stand-alone objects: $(grep -c '^{.*}$' "$POLL")" >> "$TS_OUTPUT"

ts_finalize
