TS_TOPDIR="${0%/*}/../.."
TS_DESC="poll json"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

ts_check_test_command "$TS_CMD_FINDMNT"
ts_check_test_command "$TS_CMD_MOUNT"
ts_check_test_command "$TS_CMD_UMOUNT"

ts_skip_nonroot
ts_skip_docker

MNT="$TS_MOUNTPOINT"
POLL="$TS_OUTDIR/$TS_TESTNAME.poll"

mkdir -p "$MNT/a" "$MNT/b" "$MNT/c"

# a private parent, so that the events below are about our mount points only
$TS_CMD_MOUNT --bind "$MNT" "$MNT" &> /dev/null || ts_die "cannot bind mount $MNT"
$TS_CMD_MOUNT --make-private "$MNT" &> /dev/null

# count the events for our mount points only, the poll mode reports all
# changes in the mount table
function count_events {
	local d n=0

	for d in a b c; do
		grep -qF "\"target\": \"$MNT/$d\"" "$POLL" && n=$(( n + 1 ))
	done
	echo $n
}

# --timeout, so that the background findmnt cannot outlive the test
$TS_CMD_FINDMNT --poll --json --timeout 30000 -o ACTION,TARGET \
	>"$POLL" 2>> "$TS_ERRLOG" &
FINDMNT_PID=$!
sleep 1

# Mount three file systems at the same time. They are likely to be reported
# by the same poll() wakeup, which used to print the JSON objects separated by
# commas (without an enclosing array).
MOUNT_PIDS=()
for d in a b c; do
	$TS_CMD_MOUNT -t tmpfs tmpfs "$MNT/$d" &
	MOUNT_PIDS+=($!)
done
wait "${MOUNT_PIDS[@]}"

# wait for all the events, max. 10 seconds
for i in $(seq 100); do
	[ "$(count_events)" -ge 3 ] && break
	sleep 0.1
done

kill $FINDMNT_PID
wait $FINDMNT_PID 2> /dev/null

for d in a b c; do
	$TS_CMD_UMOUNT "$MNT/$d" &> /dev/null
done
$TS_CMD_UMOUNT "$MNT" &> /dev/null

# every event has to be a top-level JSON object of its own; a line that starts
# with a comma is the separator printed between events of the same wakeup
echo "mounts: $(grep -c '"action": "mount"' "$POLL")" >> "$TS_OUTPUT"
echo "comma separated: $(grep -c '^,' "$POLL")" >> "$TS_OUTPUT"

ts_finalize
